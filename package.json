{
  "name": "gemini-tool-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "agent": "tsx --env-file-if-exists=.env src/lib/ai/agent.ts",
    "test": "vitest run",
