# Read automatically by @ai-sdk/google — do not rename.
GOOGLE_GENERATIVE_AI_API_KEY="your-aistudio-api-key"

# Optional. Default is gemini-3.5-flash-lite: 15 req/min on the free tier,
# versus 5 for the flash models and 0 for Pro (which needs billing enabled).
# GEMINI_MODEL="gemini-3.6-flash"

# Optional. Overrides the requests/minute the app assumes the provider allows.
# Normally derived from the model — set only if your key's tier differs.
# PROVIDER_RPM="15"
